# ── Installation ───────────────────────────────────────────────────
# This examples directory installs pydanticai-fluent from the main branch.
# The dependency is declared in pyproject.toml as:
#   pydanticai-fluent @ git+https://github.com/myndfire/pydanticai-fluent.git@master
#
# To pin to a specific release, edit that line to use a tag (e.g., @v0.1.0).

UV_PROJECT_VENV=.venv
LOGFIRE_TOKEN=your_logfire_token_here
OLLAMA_BASE_URL=http://localhost:11434/v1.

# ── All loop examples ───────────────────────────────────────────────
# Local Ollama model name (must be pulled first with `ollama pull <name>`)
MODEL_NAME=qwen2.5:3b

# All loop examples (caps LLM output length per run in tokens)
MAX_TOKENS=256

# ── 03_react_loop.py ──────────────────────────────────────────────
# Model for tool-calling examples (needs explicit tool support)
REACT_MODEL_NAME=qwen3.5:4b

# ── 02_iterative_refinement.py ─────────────────────────────────────
# Maximum word count allowed in the summary output
REFINEMENT_MAX_WORDS=10

# Maximum retry attempts before giving up on the summary
REFINEMENT_MAX_ATTEMPTS=3

# LLM temperature (higher = more random / verbose output)
REFINEMENT_TEMPERATURE=0.7

# ── 04_goal_seeking_loop.py ────────────────────────────────────────
# Maximum retry attempts for the goal-seeking loop
GOAL_MAX_ATTEMPTS=10

# Lower bound of the target lifespan range (years)
GOAL_LIFESPAN_MIN=7

# Upper bound of the target lifespan range (years)
GOAL_LIFESPAN_MAX=12

# LLM temperature for goal-seeking loop (higher = more random exploration)
GOAL_TEMPERATURE=0.7

# ── 05_planning_loop.py ──────────────────────────────────────────
# Model for planning loop (needs explicit tool support)
PLANNING_MODEL_NAME=llama3.1:8b

# Safety cap on how many plan steps the loop will execute
PLAN_MAX_STEPS=6

# ── RabbitMQ Document Classifier ───────────────────────────────────
# Model name for messaging/rabbitmq/rabbitmq_agent.py
RABBITMQ_AGENT_MODEL_NAME=gemma4:4b-mlx

# Model settings JSON — controls generation behavior and performance
#   thinking:         false (disable hidden reasoning — 2-5x faster for simple tasks)
#   max_tokens:       512 (hard cap on output length)
#   temperature:      0.1 (low = faster, more deterministic)
RABBITMQ_AGENT_MODEL_SETTINGS={"thinking": false, "max_tokens": 512, "temperature": 0.1}

# ── Provider API Keys (set only the ones you use) ─────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GROK_API_KEY=xai-...
# DEEPSEEK_API_KEY=sk-...
# FIREWORKS_API_KEY=fw-...
# TOGETHER_API_KEY=...
# COHERE_API_KEY=...
# MISTRAL_API_KEY=...
# CEREBRAS_API_KEY=...
# HUGGINGFACE_API_KEY=hf_...
# OPENROUTER_API_KEY=sk-or-...
# AZURE_API_KEY=...
# VERCEL_API_KEY=...
# MOONSHOTAI_API_KEY=...
# GITHUB_API_KEY=ghp_...
# HEROKU_API_KEY=...

# Ollama local endpoint (only needed if not running on localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Memory (optional — omit to use in-memory only) ──────────────
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=agent_memory
# MONGODB_COLLECTION=conversations

# ── 3-evaluators ──────────────────────────────────────────────────
# OpenAI moderation model for SafetyCheck (requires OPENAI_API_KEY)
# Options: omni-moderation-2024-09-26 (recommended), omni-moderation-latest, text-moderation-latest
SAFETY_CHECK_MODEL=omni-moderation-2024-09-26
# Agent model for evaluator examples (must be pulled first with `ollama pull <name>`)
MODEL_NAME=gpt-oss:20b
# Judge model for QualityCheck examples (provider:model_name format)
QUALITY_CHECK_MODEL=ollama:gpt-oss:20b

# ── 4-guardrails ──────────────────────────────────────────────────
# Shared model used by all guardrail examples (must be pulled first)
GUARDRAILS_MODEL_PROVIDER=ollama
GUARDRAILS_MODEL_NAME=gpt-oss:20b

# 01_agent_retries.py
AGENT_RETRIES_MAX_RETRIES=3
AGENT_RETRIES_TIMEOUT=10
AGENT_RETRIES_BACKOFF=2.0
AGENT_RETRIES_FALLBACK_MODEL=ollama:gpt-oss:20b

# 02_tool_retries.py
TOOL_RETRIES_AGENT_MAX_RETRIES=2
TOOL_RETRIES_AGENT_TIMEOUT=30
TOOL_RETRIES_MAX_RETRIES=3
TOOL_RETRIES_BACKOFF=1.5

# 03_result_validator_retries.py
VALIDATOR_AGENT_MAX_RETRIES=2
VALIDATOR_AGENT_TIMEOUT=30
VALIDATOR_MAX_RETRIES=3
VALIDATOR_BACKOFF=2.0

# 06_token_limits.py
TOKEN_LIMITS_EX1_MAX_TOTAL=50
TOKEN_LIMITS_EX1_MAX_OUTPUT=200
TOKEN_LIMITS_EX2_MAX_INPUT=500
TOKEN_LIMITS_EX2_MAX_OUTPUT=100
TOKEN_LIMITS_EX2_MAX_TOTAL=600
TOKEN_LIMITS_EX3_MAX_TOTAL=5

# 07_cost_limits.py (GPT-4o approx pricing)
COST_LIMITS_INPUT_COST=0.000003
COST_LIMITS_OUTPUT_COST=0.000015
COST_LIMITS_EX1_MAX_TOTAL=0.005
COST_LIMITS_EX2_MAX_INPUT=0.001
COST_LIMITS_EX2_MAX_OUTPUT=0.003
COST_LIMITS_EX3_MAX_TOTAL=0.000001

# 08_circuit_breaker.py
CIRCUIT_BREAKER_BAD_MODEL_NAME=this-model-does-not-exist
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=5

# 09_all_guardrails.py
ALL_GUARDRAILS_AGENT_MAX_RETRIES=3
ALL_GUARDRAILS_AGENT_TIMEOUT=30
ALL_GUARDRAILS_AGENT_BACKOFF=2.0
ALL_GUARDRAILS_TOKEN_MAX_TOTAL=500
ALL_GUARDRAILS_INPUT_COST=0.000003
ALL_GUARDRAILS_OUTPUT_COST=0.000015
ALL_GUARDRAILS_MAX_TOTAL_COST=0.01
ALL_GUARDRAILS_CIRCUIT_THRESHOLD=5
ALL_GUARDRAILS_CIRCUIT_TIMEOUT=30
ALL_GUARDRAILS_AGENT2_MAX_RETRIES=2
ALL_GUARDRAILS_AGENT2_TOKEN_MAX_TOTAL=300
ALL_GUARDRAILS_AGENT2_MAX_TOTAL_COST=0.005
ALL_GUARDRAILS_AGENT2_CIRCUIT_THRESHOLD=3

# 10_turn_limits.py
TURN_LIMITS_EX1_MAX_TURNS=3
TURN_LIMITS_EX2_MAX_TURNS=2
TURN_LIMITS_EX3_MAX_TURNS=1

# ── 08-structured_output ──────────────────────────────────────────
# Model for simple model example (01_simple_model.py)
STRUCTURED_OUTPUT_MODEL_NAME=phi4-mini

# Model with reasoning for classification/nested/validation (02, 03, 04)
STRUCTURED_OUTPUT_REASONING_MODEL=phi4-mini-reasoning

# Max LLM output tokens for all structured output examples
STRUCTURED_OUTPUT_MAX_TOKENS=512

# ── 09-tool_calling ───────────────────────────────────────────────
# LLM model for all tool calling examples
TOOL_CALLING_MODEL_NAME=gpt-oss:20b

# Max LLM output tokens for tool calling examples
TOOL_CALLING_MAX_TOKENS=512

# ── 10-prompts ────────────────────────────────────────────────────
# LLM model for all prompts examples
PROMPTS_MODEL_NAME=gpt-oss:20b

# Max LLM output tokens for prompts examples
PROMPTS_MAX_TOKENS=512

# MongoDB connection URI (only for 02_mongo_prompts.py)
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name for prompt templates
MONGODB_DATABASE=agent_prompts

# MongoDB collection name for prompt templates
MONGODB_COLLECTION=prompts

# ── 11-memory ────────────────────────────────────────────────────
# LLM model for memory examples 01-08
MEMORY_MODEL_NAME=gpt-oss:20b

# LLM model for reasoning traces (09)
REASONING_MODEL_NAME=phi4-mini-reasoning

# Max LLM output tokens for all memory examples
MEMORY_MAX_TOKENS=512

# Short-term memory turn limit
MEMORY_SHORT_TERM_MAX_TURNS=10
# Long-term memory turn limit
MEMORY_LONG_TERM_MAX_TURNS=100
# Audit log turn limit (03_multi_provider only)
MEMORY_AUDIT_MAX_TURNS=10000
# MongoDB connection timeout in ms (05, 07)
MEMORY_MONGODB_TIMEOUT_MS=2000
# Redis connection timeout in seconds (06, 07)
MEMORY_REDIS_CONNECT_TIMEOUT=2
# Reasoning agent timeout in seconds (09)
MEMORY_REASONING_TIMEOUT=60

# MongoDB connection URI (for 05_mongo_memory, 07_combined_memory)
# MONGODB_URI=mongodb://localhost:27017

# MongoDB database name for conversation storage
# MONGODB_DATABASE=agent_memory

# MongoDB collection name for conversation storage
# MONGODB_COLLECTION=conversations

# Redis host (for 06_redis_memory, 07_combined_memory)
# REDIS_HOST=localhost

# Redis port
# REDIS_PORT=6379

# Redis key prefix for session isolation
# REDIS_KEY_PREFIX=agent:memory:

# Elasticsearch endpoint (for 08_elasticsearch_memory)
# ELASTICSEARCH_ENDPOINT=http://localhost:9200

# Elasticsearch index name for memory storage
# ELASTICSEARCH_INDEX=agent-memory

# ── 12-observability ──────────────────────────────────────────────
# LLM model for observability examples (03, 05-09)
OBSERVABILITY_MODEL_NAME=gpt-oss:20b

# Max LLM output tokens for observability examples
OBSERVABILITY_MAX_TOKENS=512

# Elasticsearch endpoint (for 05_elasticsearch_logging, 09_otel_oltp)
# ELASTICSEARCH_ENDPOINT=http://localhost:9200

# Jaeger OTLP gRPC endpoint (for 06_otel_jaeger, 09_otel_oltp)
# JAEGER_OTLP_ENDPOINT=localhost:4317

# Prometheus push gateway URL (for 07_prometheus)
# PROMETHEUS_PUSH_GATEWAY=http://localhost:9091

# OTel Collector OTLP gRPC endpoint (for 09_otel_oltp)
# OTEL_COLLECTOR_ENDPOINT=localhost:14317

# OTLP service name (for 09_otel_oltp)
# OBSERVABILITY_SERVICE_NAME=all-in-one-observability-demo

UV_PROJECT_VENV=.venv
LOGFIRE_TOKEN=your_logfire_token_here

# ── All loop examples ───────────────────────────────────────────────
# Local Ollama model name (must be pulled first with `ollama pull <name>`)
MODEL_NAME=qwen2.5:3b

# All loop examples (caps LLM output length per run in tokens)
MAX_TOKENS=256

# ── 03_react_loop.py ──────────────────────────────────────────────
# Model for tool-calling examples (needs explicit tool support)
REACT_MODEL_NAME=qwen3.5:4b

# ── 02_iterative_refinement.py ─────────────────────────────────────
# Maximum word count allowed in the summary output
REFINEMENT_MAX_WORDS=10

# Maximum retry attempts before giving up on the summary
REFINEMENT_MAX_ATTEMPTS=3

# LLM temperature (higher = more random / verbose output)
REFINEMENT_TEMPERATURE=0.7

# ── 04_goal_seeking_loop.py ────────────────────────────────────────
# Maximum retry attempts for the goal-seeking loop
GOAL_MAX_ATTEMPTS=10

# Lower bound of the target lifespan range (years)
GOAL_LIFESPAN_MIN=7

# Upper bound of the target lifespan range (years)
GOAL_LIFESPAN_MAX=12

# LLM temperature for goal-seeking loop (higher = more random exploration)
GOAL_TEMPERATURE=0.7

# ── 05_planning_loop.py ──────────────────────────────────────────
# Model for planning loop (needs explicit tool support)
PLANNING_MODEL_NAME=llama3.1:8b

# Safety cap on how many plan steps the loop will execute
PLAN_MAX_STEPS=6

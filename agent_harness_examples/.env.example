# ═══════════════════════════════════════════════════════════════════
# Agent Harness Examples — Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Global / Shared ──────────────────────────────────────────────
UV_PROJECT_VENV=.venv
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-proj...

# Default model for most examples (must be pulled first with `ollama pull <name>`)
MODEL_NAME=granite4.1:8b

# Default max LLM output tokens per run
MAX_TOKENS=256

# Default LLM provider (used by 07-orchestration and others)
LLM_PROVIDER=ollama

# ── OpenTelemetry (all examples use OTEL by default) ─────────────
OTEL_COLLECTOR_ENDPOINT=localhost:4317
OBSERVABILITY_SERVICE_NAME=agent-harness

# Harness telemetry granularity: minimal | standard | verbose
#   minimal  -> run summary + warnings/errors only
#   standard -> + per-turn records/metrics, enriched TurnData
#   verbose  -> + retries, lifecycle events, trace content, TTFT (dev)
HARNESS_TELEMETRY_LEVEL=verbose
# Render OTel records to the local console via the OTel console exporters
HARNESS_TELEMETRY_CONSOLE=true
# Max innermost traceback frames in error stacktraces.
# Unset, empty or 0 keeps the FULL traceback; a positive N keeps the last N.
HARNESS_DEFAULT_TRACEBACK_FRAMES=0

# ── Langfuse (traces) + docker compose secrets ──────────────────
# Seeded automatically on first `docker compose up -d`.
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=local-project
LANGFUSE_INIT_PROJECT_NAME=Local Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local

# Initial Langfuse user (v4) — shared UI login across UIs
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=Admin1234!

# Dev convenience: keep Langfuse users signed in ~1 year (minutes) so login is
# a one-time event. Authentication is still required; this only extends the
# session lifetime.
AUTH_SESSION_MAX_AGE=525600

# docker compose secrets (local dev values — regenerate for anything non-local:
#   NEXTAUTH_SECRET / SALT: openssl rand -base64 32
#   ENCRYPTION_KEY:         openssl rand -hex 32)
NEXTAUTH_SECRET=E9wH/JpP0SxzZZUg58L/JHVImBvepOcieN6Wr8hFzKA=
SALT=cWPs1aINEqApQeviJpKNS0pX2PwTtnqDrZ/4LQ1+BFs=
ENCRYPTION_KEY=9e8587265e74bd67013fa34e9c2c2bdb06785f3c5fb2ef39afe10c2c2f2331c4

# Collector → Langfuse target (in-Docker hostname)
LANGFUSE_HOST=http://langfuse-web:3000
# base64(public:secret): echo -n "pk-lf-local:sk-lf-local" | base64
LANGFUSE_AUTH=cGstbGYtbG9jYWw6c2stbGYtbG9jYWw=

# Browser-reachable Langfuse UI + project id, used to build deep links from
# structured logs (e.g. Kibana trace_id -> Langfuse trace). LANGFUSE_HOST
# above is the in-Docker hostname and is not browser-reachable.
LANGFUSE_PROJECT_ID=local-project
LANGFUSE_UI_URL=http://localhost:3000

# ── OpenObserve (unified logs + metrics + traces UI) ────────────
# Shared UI login: admin@example.com / Admin1234! (same as Langfuse).
# OpenObserve requires 8-128 chars with upper+lower+digit+special.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=Admin1234!
# In-Docker OTLP/HTTP endpoint the collector exports to (no trailing slash)
OPENOBSERVE_ENDPOINT=http://openobserve:5080/api/default
# base64(email:password) for the collector Authorization header:
#   echo -n "admin@example.com:Admin1234!" | base64
OPENOBSERVE_AUTH=YWRtaW5AZXhhbXBsZS5jb206QWRtaW4xMjM0IQ==
# Browser-reachable UI
OPENOBSERVE_UI_URL=http://localhost:5080

# ── 01-getting_started ──────────────────────────────────────────
# Uses: MODEL_NAME, MAX_TOKENS (shared above)
# No additional env vars required.

# ── 02-error_handling ───────────────────────────────────────────
# No env vars required (all examples use hardcoded defaults).

# ── 03-evaluators ───────────────────────────────────────────────
# Uses: MODEL_NAME (shared above)

# Judge model for QualityCheck examples (provider:model_name format)
QUALITY_CHECK_MODEL=ollama:gpt-oss:20b

# OpenAI moderation model for SafetyCheck (requires OPENAI_API_KEY)
# Options: omni-moderation-2024-09-26 (recommended), omni-moderation-latest, text-moderation-latest
SAFETY_CHECK_MODEL=omni-moderation-2024-09-26

# ── 04-guardrails ───────────────────────────────────────────────
# Shared model used by all guardrail examples (must be pulled first)
GUARDRAILS_MODEL_PROVIDER=ollama
GUARDRAILS_MODEL_NAME=gpt-oss:20b

# 01_agent_retries.py
AGENT_RETRIES_MAX_RETRIES=3
